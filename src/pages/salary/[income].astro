---
import Layout from "../../layouts/Layout.astro";
import { DEFAULT_SCENARIO } from "../../lib/state/schema";
import { scenarioToQueryString } from "../../lib/state/serialize";
import { computeResults } from "../../lib/state/computeResults";
import { estimateNetMonthlyIncome } from "../../lib/estimateNetIncome";
import { getPropertyTaxRate } from "../../lib/data/property-tax-by-state";
import { formatUSD } from "../../lib/format";
import type { ScenarioState } from "../../lib/state/schema";

export function getStaticPaths() {
  const paths = [];
  for (let income = 40_000; income <= 250_000; income += 5_000) {
    paths.push({ params: { income: String(income) } });
  }
  return paths;
}

const MIN_INCOME = 40_000;
const MAX_INCOME = 250_000;
const INCOME_STEP = 5_000;

const { income: incomeParam } = Astro.params;
const grossAnnualIncome = Number(incomeParam);

const scenario: ScenarioState = {
  ...DEFAULT_SCENARIO,
  grossAnnualIncome,
  netMonthlyIncome: estimateNetMonthlyIncome(grossAnnualIncome),
};

const results = computeResults(scenario);
const stateName = getPropertyTaxRate(scenario.stateCode).state;
const calculatorHref = `/mortgage-calculator${scenarioToQueryString(scenario)}`;

const incomeLabel = formatUSD(grossAnnualIncome).replace(/\.00$/, "");
const title = `What Can You Afford on a ${incomeLabel} Salary? | TrueAfford`;
const description = results.isUnaffordable
  ? `On a ${incomeLabel} salary with typical debts and expenses, this baseline scenario doesn't clear affordability thresholds yet. See exactly what would change that.`
  : `On a ${incomeLabel} salary, a household with typical debts and expenses could comfortably afford up to ${formatUSD(results.comfortableMax)} — see the Stretch and Risky ceilings, and the gap between what a lender would approve and what your budget can sustain.`;

const gap = results.riskyMax - results.sustainableMax;

const lowerIncome = grossAnnualIncome > MIN_INCOME ? grossAnnualIncome - INCOME_STEP : null;
const higherIncome = grossAnnualIncome < MAX_INCOME ? grossAnnualIncome + INCOME_STEP : null;
---

<Layout title={title} description={description}>
  <section class="container hero">
    <p class="eyebrow">Home Affordability by Income</p>
    <h1>What can you afford on a {incomeLabel} salary?</h1>
    <p class="intro">
      A baseline estimate for a household earning {incomeLabel} a year gross, assuming typical monthly debts and expenses, a {formatUSD(scenario.downPaymentDollars)} down payment, a {scenario.creditBand} credit score, and{" "}
      {stateName}'s property tax and insurance rates as a default reference point. Every one of these assumptions is editable — the full calculator below opens pre-filled with these exact numbers.
    </p>
  </section>

  <section class="container section">
    {
      results.isUnaffordable ? (
        <div class="callout callout-unaffordable">
          <p class="callout-title">Not affordable at this baseline yet</p>
          <ul>
            {results.unaffordableReasons.map((reason) => (
              <li>{reason}</li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="tier-grid">
          <div class="tier-card" data-tier="comfortable">
            <p class="tier-label">Comfortable</p>
            <p class="tier-value">{formatUSD(results.comfortableMax)}</p>
          </div>
          <div class="tier-card" data-tier="stretch">
            <p class="tier-label">Stretch</p>
            <p class="tier-value">{formatUSD(results.stretchMax)}</p>
          </div>
          <div class="tier-card" data-tier="risky">
            <p class="tier-label">Risky ceiling</p>
            <p class="tier-value">{formatUSD(results.riskyMax)}</p>
          </div>
        </div>
      )
    }

    <p class="narrative">
      {results.isUnaffordable
        ? `Even the Risky ceiling doesn't clear at this baseline — the calculator below shows exactly what's driving that and lets you adjust debts, expenses, or down payment to see what would change it.`
        : gap > 500
          ? `A lender would likely approve up to ${formatUSD(results.riskyMax)} on this income — but this household's own budget, once real expenses are counted, can only sustain ${formatUSD(results.sustainableMax)}. That ${formatUSD(gap)} gap is exactly the kind of overreach this calculator exists to flag before it becomes a monthly deficit.`
          : `This baseline's own budget can sustain at least as much as a lender's debt-to-income ceiling allows — the DTI ratio, not the household budget, is what limits the number here.`}
    </p>

    <a class="btn-primary" href={calculatorHref}>Open the full calculator with these numbers</a>
  </section>

  <section class="container section nav-section">
    <p class="section-heading">Other income levels</p>
    <p class="income-nav">
      {lowerIncome !== null && <a href={`/salary/${lowerIncome}`}>← {formatUSD(lowerIncome)}</a>}
      {higherIncome !== null && <a href={`/salary/${higherIncome}`}>{formatUSD(higherIncome)} →</a>}
    </p>
    <p class="cross-links">
      <a href="/salary">Browse all income levels</a> · <a href="/state">Browse by state</a> · <a href="/mortgage-calculator">Full mortgage calculator</a> · <a href="/methodology">Methodology</a>
    </p>
  </section>
</Layout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-xl);
    max-width: 760px;
  }

  .hero h1 {
    font-size: var(--text-heading-lg-size);
    font-weight: var(--text-heading-lg-weight);
    letter-spacing: var(--text-heading-lg-tracking);
    margin-block: var(--space-sm) var(--space-md);
  }

  .hero .intro {
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--color-body);
  }

  .section {
    max-width: 760px;
    padding-bottom: var(--space-2xl);
  }

  .section-heading {
    font-weight: 600;
    font-size: var(--text-label-sm-size);
    margin-bottom: var(--space-xs);
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  @media (max-width: 640px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
  }

  .tier-card {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .tier-card[data-tier="comfortable"] {
    background: var(--color-comfortable-soft);
  }
  .tier-card[data-tier="stretch"] {
    background: var(--color-stretch-soft);
  }
  .tier-card[data-tier="risky"] {
    background: var(--color-risky-soft);
  }

  .tier-label {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-bottom: var(--space-xxs);
  }

  .tier-value {
    font-size: var(--text-heading-md-size);
    font-weight: 600;
  }

  .narrative {
    color: var(--color-body);
    line-height: var(--text-body-lg-leading);
    margin-bottom: var(--space-lg);
  }

  .callout {
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background: var(--color-unaffordable-soft);
    margin-bottom: var(--space-lg);
  }

  .callout-title {
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .callout ul {
    margin: 0;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-ink);
    color: var(--color-on-ink);
    border: none;
    border-radius: var(--radius-pill);
    padding: var(--space-sm) var(--space-lg);
    font-size: var(--text-button-lg-size);
    font-weight: var(--text-button-lg-weight);
    text-decoration: none;
  }

  .nav-section {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-lg);
  }

  .income-nav {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-body-sm-size);
    margin-bottom: var(--space-md);
  }

  .income-nav a {
    color: var(--color-link);
    text-decoration: none;
  }

  .cross-links {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
  }

  .cross-links a {
    color: var(--color-link);
    text-decoration: none;
  }
</style>
