---
import Layout from "../../layouts/Layout.astro";
import { scenarioToQueryString } from "../../lib/state/serialize";
import { computeResults } from "../../lib/state/computeResults";
import { salaryBaselineScenario } from "../../lib/salaryBaseline";
import { getPropertyTaxRate } from "../../lib/data/property-tax-by-state";
import { getDefaultInterestRate, BASE_RATE_AS_OF } from "../../lib/data/interest-rates-by-credit-band";
import { formatUSD, formatPct } from "../../lib/format";
import type { ScenarioState } from "../../lib/state/schema";

export function getStaticPaths() {
  const paths = [];
  for (let income = 40_000; income <= 250_000; income += 5_000) {
    paths.push({ params: { income: String(income) } });
  }
  return paths;
}

const MIN_INCOME = 40_000;
const MAX_INCOME = 250_000;
const INCOME_STEP = 5_000;

const { income: incomeParam } = Astro.params;
const grossAnnualIncome = Number(incomeParam);

const scenario: ScenarioState = salaryBaselineScenario(grossAnnualIncome);

const results = computeResults(scenario);
const stateName = getPropertyTaxRate(scenario.stateCode).state;
const calculatorHref = `/home-affordability-calculator/${scenarioToQueryString(scenario)}`;

const incomeLabel = formatUSD(grossAnnualIncome).replace(/\.00$/, "");

// A tier max at or below the cash down payment isn't a meaningful home
// price — the same condition the engine flags as downPaymentExceedsMaxPrice.
const isReached = (maxPrice: number) => maxPrice > scenario.downPaymentDollars;
const comfortableReached = isReached(results.comfortableMax);
const stretchReached = isReached(results.stretchMax);
const riskyReached = !results.isUnaffordable && isReached(results.riskyMax);

const tiers = [
  { key: "comfortable", label: "Comfortable", max: results.comfortableMax, reached: comfortableReached },
  { key: "stretch", label: "Stretch", max: results.stretchMax, reached: stretchReached },
  { key: "risky", label: "Risky ceiling", max: results.riskyMax, reached: riskyReached },
];

const title = `How Much House Can You Afford on a ${incomeLabel} Salary? | TrueAfford`;

const answer = comfortableReached
  ? `With typical debts and expenses, a household earning ${incomeLabel} a year can comfortably afford a home up to ${formatUSD(results.comfortableMax)}. The Stretch tier reaches ${formatUSD(results.stretchMax)}, and a lender may approve up to ${formatUSD(results.riskyMax)}.`
  : stretchReached
    ? `At this baseline, a household earning ${incomeLabel} a year doesn't reach the Comfortable tier. The Stretch tier — a tight, break-even budget — reaches a home price of ${formatUSD(results.stretchMax)}, and a lender may approve up to ${formatUSD(results.riskyMax)}.`
    : riskyReached
      ? `At this baseline, a household earning ${incomeLabel} a year doesn't reach the Comfortable or Stretch tiers — after typical debts and expenses, too little is left each month. A lender's debt-to-income ratios alone would allow a home up to ${formatUSD(results.riskyMax)}, with no budget cushion.`
      : `At this baseline, a household earning ${incomeLabel} a year doesn't reach any affordability tier for buying a home yet.`;

const description = comfortableReached
  ? `On a ${incomeLabel} salary, a household with typical debts and expenses could comfortably afford a home up to ${formatUSD(results.comfortableMax)} — see the Stretch and Risky ceilings and the assumptions behind them.`
  : `On a ${incomeLabel} salary with typical debts and expenses, this baseline doesn't reach the Comfortable home-affordability tier. See the assumptions and what would change that.`;

const netMonthly = scenario.netMonthlyIncome;
const livingExpenses = scenario.childcare + scenario.healthcare + scenario.groceries + scenario.transport + scenario.otherExpenses;
const ratePct = formatPct(getDefaultInterestRate(scenario.creditBand, scenario.termYears), 2);

const gap = results.riskyMax - results.sustainableMax;
const sustainableReached = isReached(results.sustainableMax);

const lowerIncome = grossAnnualIncome > MIN_INCOME ? grossAnnualIncome - INCOME_STEP : null;
const higherIncome = grossAnnualIncome < MAX_INCOME ? grossAnnualIncome + INCOME_STEP : null;
---

<Layout title={title} description={description}>
  <section class="container hero">
    <p class="eyebrow">Home Affordability by Income</p>
    <h1>How much house can you afford on a {incomeLabel} salary?</h1>
    <p class="answer">{answer}</p>
  </section>

  <section class="container section">
    {
      results.isUnaffordable ? (
        <div class="callout callout-unaffordable">
          <p class="callout-title">Not affordable at this baseline yet</p>
          <ul>
            {results.unaffordableReasons.map((reason) => (
              <li>{reason}</li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="tier-grid">
          {tiers.map((tier) => (
            <div class="tier-card" data-tier={tier.key}>
              <p class="tier-label">{tier.label}</p>
              {tier.reached ? <p class="tier-value">{formatUSD(tier.max)}</p> : <p class="tier-value tier-not-reached">Not reached at this baseline</p>}
            </div>
          ))}
        </div>
      )
    }

    <p class="section-heading">Baseline assumptions</p>
    <dl class="assumptions">
      <div><dt>Take-home pay (estimated)</dt><dd>{formatUSD(netMonthly)}/mo — an illustrative 78% of gross, not a tax calculation</dd></div>
      <div><dt>Other debt payments</dt><dd>{formatUSD(scenario.otherMonthlyDebts)}/mo</dd></div>
      <div>
        <dt>Living expenses</dt>
        <dd>
          {formatUSD(livingExpenses)}/mo — childcare {formatUSD(scenario.childcare)}, healthcare {formatUSD(scenario.healthcare)}, groceries {formatUSD(scenario.groceries)}, transport {formatUSD(scenario.transport)}, other {formatUSD(scenario.otherExpenses)}
        </dd>
      </div>
      <div><dt>Down payment</dt><dd>{formatUSD(scenario.downPaymentDollars)}</dd></div>
      <div><dt>Loan</dt><dd>{scenario.termYears}-year fixed at {ratePct} ({scenario.creditBand} credit; static rate as of {BASE_RATE_AS_OF})</dd></div>
      <div><dt>Property tax &amp; insurance</dt><dd>{stateName} rates, as a default reference point</dd></div>
    </dl>
    <p class="assumptions-note">Every assumption is editable — the full calculator opens pre-filled with these exact numbers.</p>

    <p class="narrative">
      {results.isUnaffordable
        ? `Even the Risky ceiling doesn't clear at this baseline — the calculator below shows exactly what's driving that and lets you adjust debts, expenses, or down payment to see what would change it.`
        : !sustainableReached
          ? `A lender's ratios alone would allow up to ${formatUSD(results.riskyMax)} on this income — but once real expenses are counted, this household's own budget can't sustain a home purchase at this baseline. That gap is exactly the kind of overreach this calculator exists to flag before it becomes a monthly deficit.`
          : gap > 500
            ? `A lender would likely approve up to ${formatUSD(results.riskyMax)} on this income — but this household's own budget, once real expenses are counted, can only sustain ${formatUSD(results.sustainableMax)}. That ${formatUSD(gap)} gap is exactly the kind of overreach this calculator exists to flag before it becomes a monthly deficit.`
            : `This baseline's own budget can sustain at least as much as a lender's debt-to-income ceiling allows — the DTI ratio, not the household budget, is what limits the number here.`}
    </p>

    <a class="btn-primary" href={calculatorHref}>Open the home affordability calculator with these numbers</a>
  </section>

  <section class="container section nav-section">
    <p class="section-heading">Other income levels</p>
    <p class="income-nav">
      {lowerIncome !== null && <a href={`/salary/${lowerIncome}/`}>← {formatUSD(lowerIncome)}</a>}
      {higherIncome !== null && <a href={`/salary/${higherIncome}/`}>{formatUSD(higherIncome)} →</a>}
    </p>
    <p class="cross-links">
      <a href="/salary/">Browse all income levels</a> · <a href="/state/">Browse by state</a> · <a href="/mortgage-calculator/">Full mortgage calculator</a> · <a href="/methodology/">Methodology</a>
    </p>
  </section>
</Layout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-xl);
    max-width: 760px;
  }

  .hero h1 {
    font-size: var(--text-heading-lg-size);
    font-weight: var(--text-heading-lg-weight);
    letter-spacing: var(--text-heading-lg-tracking);
    margin-block: var(--space-sm) var(--space-md);
  }

  .hero .answer {
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--color-body);
  }

  .tier-not-reached {
    font-size: var(--text-body-sm-size);
    font-weight: 500;
    color: var(--color-mute);
  }

  .assumptions {
    margin: 0 0 var(--space-xs);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    font-size: var(--text-body-sm-size);
  }

  .assumptions > div {
    display: grid;
    grid-template-columns: minmax(140px, 200px) 1fr;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    border-bottom: 1px solid var(--color-hairline-soft);
  }

  .assumptions > div:last-child {
    border-bottom: none;
  }

  @media (max-width: 480px) {
    .assumptions > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .assumptions dt {
    color: var(--color-mute);
  }

  .assumptions dd {
    margin: 0;
    color: var(--color-body);
  }

  .assumptions-note {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-bottom: var(--space-lg);
  }

  .section {
    max-width: 760px;
    padding-bottom: var(--space-2xl);
  }

  .section-heading {
    font-weight: 600;
    font-size: var(--text-label-sm-size);
    margin-bottom: var(--space-xs);
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  @media (max-width: 640px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
  }

  .tier-card {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .tier-card[data-tier="comfortable"] {
    background: var(--color-comfortable-soft);
  }
  .tier-card[data-tier="stretch"] {
    background: var(--color-stretch-soft);
  }
  .tier-card[data-tier="risky"] {
    background: var(--color-risky-soft);
  }

  .tier-label {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-bottom: var(--space-xxs);
  }

  .tier-value {
    font-size: var(--text-heading-md-size);
    font-weight: 600;
  }

  .narrative {
    color: var(--color-body);
    line-height: var(--text-body-lg-leading);
    margin-bottom: var(--space-lg);
  }

  .callout {
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background: var(--color-unaffordable-soft);
    margin-bottom: var(--space-lg);
  }

  .callout-title {
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .callout ul {
    margin: 0;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-ink);
    color: var(--color-on-ink);
    border: none;
    border-radius: var(--radius-pill);
    padding: var(--space-sm) var(--space-lg);
    font-size: var(--text-button-lg-size);
    font-weight: var(--text-button-lg-weight);
    text-decoration: none;
  }

  .nav-section {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-lg);
  }

  .income-nav {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-body-sm-size);
    margin-bottom: var(--space-md);
  }

  .income-nav a {
    color: var(--color-link);
    text-decoration: none;
  }

  .cross-links {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
  }

  .cross-links a {
    color: var(--color-link);
    text-decoration: none;
  }
</style>
