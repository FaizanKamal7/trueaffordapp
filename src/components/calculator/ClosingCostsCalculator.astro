---
import { decodeScenario, scenarioToQueryString } from "../../lib/state/serialize";
import { computeResults } from "../../lib/state/computeResults";
import { estimateClosingCosts } from "../../lib/engine/closingCosts";
import { formatUSD } from "../../lib/format";

const scenario = decodeScenario(Astro.url.searchParams);
const affordabilityResults = computeResults(scenario);
const homePrice = scenario.evaluatedHomePrice ?? affordabilityResults.defaultEvaluatedPrice;
const closingCosts = estimateClosingCosts(homePrice, scenario.downPaymentDollars);

const shareUrl = new URL(Astro.url.pathname + scenarioToQueryString(scenario), Astro.site ?? Astro.url.origin).toString();
---

<div class="calculator-grid" data-closing-calculator>
  <form id="closing-form" class="calculator-form-col" method="get">
    <fieldset class="field-group">
      <legend>Purchase</legend>
      <label class="field">
        <span>Home price</span>
        <input type="number" inputmode="numeric" name="ep" id="field-ep" min="0" step="1000" value={homePrice} />
      </label>
      <label class="field">
        <span>Down payment</span>
        <input type="number" inputmode="numeric" name="dp" id="field-dp" min="0" step="1000" value={scenario.downPaymentDollars} />
      </label>
    </fieldset>

    <noscript>
      <button type="submit" class="btn-primary">Calculate</button>
    </noscript>
  </form>

  <div class="results-col" id="closing-results" aria-live="polite">
    <div>
      <p class="eyebrow">Cash needed at closing</p>
      <h2>
        <strong id="total-cash-typical" data-bind="totalCashTypical">{formatUSD(closingCosts.totalCashNeededTypical)}</strong> typical
      </h2>
      <p class="range-note" id="range-note" data-bind="rangeNote">
        Range: {formatUSD(closingCosts.totalCashNeededLow)} – {formatUSD(closingCosts.totalCashNeededHigh)}
      </p>
    </div>

    <dl class="breakdown-list">
      <div class="breakdown-row">
        <dt>Down payment</dt>
        <dd id="down-payment-line" data-bind="downPayment">{formatUSD(scenario.downPaymentDollars)}</dd>
      </div>
      <div class="breakdown-row">
        <dt>Closing costs (low, 2%)</dt>
        <dd id="cc-low" data-bind="ccLow">{formatUSD(closingCosts.low)}</dd>
      </div>
      <div class="breakdown-row">
        <dt>Closing costs (typical, 3%)</dt>
        <dd id="cc-typical" data-bind="ccTypical">{formatUSD(closingCosts.typical)}</dd>
      </div>
      <div class="breakdown-row breakdown-subtotal">
        <dt>Closing costs (high, 5%)</dt>
        <dd id="cc-high" data-bind="ccHigh">{formatUSD(closingCosts.high)}</dd>
      </div>
      <div class="breakdown-row breakdown-total">
        <dt>Total cash needed (typical)</dt>
        <dd id="total-cash-line" data-bind="totalCashTypical2">{formatUSD(closingCosts.totalCashNeededTypical)}</dd>
      </div>
    </dl>

    <p class="closing-note">This is cash on top of the down payment — lender fees, title insurance, appraisal, recording fees, and similar one-time costs. It's frequently the thing first-time buyers forget to budget for.</p>

    <div class="share-row">
      <label class="field">
        <span>Share this exact scenario</span>
        <input type="text" id="share-url" readonly value={shareUrl} onfocus="this.select()" />
      </label>
      <button type="button" id="copy-share-link" class="btn-primary-sm">Copy link</button>
      <span id="copy-confirmation" role="status" class="copy-confirmation" hidden>Copied!</span>
    </div>
  </div>
</div>

<script>
  import { initClosingCostsCalculator } from "../../scripts/closingCostsCalculatorClient";
  initClosingCostsCalculator();
</script>

<style>
  .range-note {
    color: var(--color-mute);
    font-size: var(--text-body-sm-size);
  }

  .closing-note {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
  }
</style>
