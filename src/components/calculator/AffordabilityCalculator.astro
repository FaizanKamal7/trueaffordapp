---
import { decodeScenario, scenarioToQueryString } from "../../lib/state/serialize";
import { computeResults } from "../../lib/state/computeResults";
import { getDefaultInterestRate } from "../../lib/data/interest-rates-by-credit-band";
import { PROPERTY_TAX_BY_STATE } from "../../lib/data/property-tax-by-state";
import { CREDIT_BANDS } from "../../lib/data/pmi-rates";
import { formatUSD, formatSignedUSD, formatPct } from "../../lib/format";
import ScaleBar from "./ScaleBar.astro";

import { DEFAULT_LOCALE, localizedPath, type LocaleCode } from "../../i18n/locales";
import { CALCULATOR_COPY } from "../../i18n/calculators";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = CALCULATOR_COPY[locale];
const methodologyHref = localizedPath(locale, "methodology");

const scenario = decodeScenario(Astro.url.searchParams);
const results = computeResults(scenario);
const { affordability, sensitivity } = results;
const { breakdown } = affordability;

const stateList = Object.values(PROPERTY_TAX_BY_STATE).sort((a, b) => a.state.localeCompare(b.state));
const defaultRatePct = getDefaultInterestRate(scenario.creditBand, scenario.termYears) * 100;

const shareQuery = scenarioToQueryString(scenario);
const shareUrl = new URL(Astro.url.pathname + shareQuery, Astro.site ?? Astro.url.origin).toString();

const tierLabels = t.tiers;
const ta = t.affordability;

const lenderSustainableGap = results.riskyMax - results.sustainableMax;
---

<div class="calculator" data-calculator data-locale={locale}>
  <form id="calculator-form" class="calculator-form" method="get">
    <div class="mobile-result-summary" aria-hidden="true">
      <p class="eyebrow">{t.common.yourResult}</p>
      <p class="mobile-result-value" id="mobile-result-headline">
        {
          results.isUnaffordable ? (
            t.common.notAffordableYet
          ) : (
            <>
              <span class="tier-badge" data-tier={affordability.tier}>
                {tierLabels[affordability.tier]}
              </span>{" "}
              {t.common.upTo.trimStart()}<strong>{formatUSD(results.evaluatedPrice)}</strong>
            </>
          )
        }
      </p>
      <p class="mobile-result-note">{t.common.sustainUpTo} <span data-bind="sustainableMax">{formatUSD(results.sustainableMax)}</span></p>
      <a href="#results" tabindex="-1">{t.common.seeFullBreakdown}</a>
    </div>
    <fieldset class="field-group">
      <legend>{t.common.incomeAndDebts}</legend>

      <label class="field">
        <span>{t.common.grossIncome}</span>
        <input type="number" inputmode="numeric" name="gi" id="field-gi" min="0" step="1000" value={scenario.grossAnnualIncome} />
      </label>

      <label class="field">
        <span>{t.common.netIncome}</span>
        <input type="number" inputmode="numeric" name="ni" id="field-ni" min="0" step="50" value={scenario.netMonthlyIncome} />
      </label>

      <label class="field">
        <span>{t.common.otherDebts} <a class="info-link" href={`${methodologyHref}#dti`} aria-label={t.common.whyThisMatters}>?</a></span>
        <input type="number" inputmode="numeric" name="od" id="field-od" min="0" step="25" value={scenario.otherMonthlyDebts} />
      </label>
    </fieldset>

    <fieldset class="field-group">
      <legend>{t.common.realLifeExpenses} <a class="info-link" href={`${methodologyHref}#leftover-income`} aria-label={t.common.whyThisMatters}>?</a></legend>
      <p class="field-group-note">{ta.expensesNote}</p>

      <label class="field">
        <span>{t.common.childcare}</span>
        <input type="number" inputmode="numeric" name="ec" id="field-ec" min="0" step="25" value={scenario.childcare} />
      </label>
      <label class="field">
        <span>{t.common.healthcare}</span>
        <input type="number" inputmode="numeric" name="eh" id="field-eh" min="0" step="25" value={scenario.healthcare} />
      </label>
      <label class="field">
        <span>{t.common.groceries}</span>
        <input type="number" inputmode="numeric" name="eg" id="field-eg" min="0" step="25" value={scenario.groceries} />
      </label>
      <label class="field">
        <span>{t.common.transport}</span>
        <input type="number" inputmode="numeric" name="et" id="field-et" min="0" step="25" value={scenario.transport} />
      </label>
      <label class="field">
        <span>{t.common.other}</span>
        <input type="number" inputmode="numeric" name="eo" id="field-eo" min="0" step="25" value={scenario.otherExpenses} />
      </label>
    </fieldset>

    <fieldset class="field-group">
      <legend>{ta.loanAssumptions}</legend>

      <label class="field">
        <span>{t.common.state}</span>
        <select name="st" id="field-st">
          {
            stateList.map((entry) => (
              <option value={entry.stateCode} selected={entry.stateCode === scenario.stateCode}>
                {entry.state}
              </option>
            ))
          }
        </select>
      </label>

      <label class="field">
        <span>{ta.downPaymentAvailable}</span>
        <input type="number" inputmode="numeric" name="dp" id="field-dp" min="0" step="1000" value={scenario.downPaymentDollars} />
      </label>

      <label class="field">
        <span>{t.common.creditBand}</span>
        <select name="cb" id="field-cb">
          {
            CREDIT_BANDS.map((band) => (
              <option value={band} selected={band === scenario.creditBand}>
                {band}
              </option>
            ))
          }
        </select>
      </label>

      <label class="field">
        <span>{t.common.rateOverride} <a class="info-link" href={`${methodologyHref}#rates`} aria-label={t.common.whyThisMatters}>?</a></span>
        <input
          type="number"
          inputmode="decimal"
          name="ir"
          id="field-ir"
          min="0"
          max="20"
          step="0.05"
          placeholder={defaultRatePct.toFixed(2)}
          value={scenario.interestRateOverride !== undefined ? (scenario.interestRateOverride * 100).toFixed(2) : ""}
        />
      </label>

      <fieldset class="field-inline">
        <legend>{t.common.loanTerm}</legend>
        <label><input type="radio" name="tm" value="30" checked={scenario.termYears === 30} /> {t.common.termYears(30)}</label>
        <label><input type="radio" name="tm" value="15" checked={scenario.termYears === 15} /> {t.common.termYears(15)}</label>
      </fieldset>

      <label class="field">
        <span>{ta.hoaMonthly}</span>
        <input type="number" inputmode="numeric" name="hoa" id="field-hoa" min="0" step="10" value={scenario.hoaMonthly} />
      </label>
    </fieldset>

    <noscript>
      <button type="submit" class="btn-primary">{t.common.calculate}</button>
    </noscript>
  </form>

  <div class="results" id="results" aria-live="polite">
    <div class="results-header">
      <p class="eyebrow">{t.common.yourResult}</p>
      {
        results.isUnaffordable ? (
          <h2 id="result-headline" data-bind="headline">
            {t.common.notAffordableYet}
          </h2>
        ) : (
          <h2 id="result-headline" data-bind="headline">
            <span class="tier-badge" data-tier={affordability.tier} id="result-tier-badge">
              {tierLabels[affordability.tier]}
            </span>{" "}
            {t.common.upTo.trimStart()}<strong id="result-evaluated-price" data-bind="evaluatedPrice">{formatUSD(results.evaluatedPrice)}</strong>
          </h2>
        )
      }
    </div>

    <ScaleBar locale={locale} comfortableMax={results.comfortableMax} stretchMax={results.stretchMax} riskyMax={results.riskyMax} evaluatedPrice={results.evaluatedPrice} />

    <div class="evaluate-row">
      <label class="field">
        <span>{ta.testPrice}</span>
        <input
          type="number"
          inputmode="numeric"
          name="ep"
          id="field-ep"
          form="calculator-form"
          min="0"
          step="1000"
          value={results.isCustomEvaluatedPrice ? results.evaluatedPrice : ""}
          placeholder={String(results.defaultEvaluatedPrice)}
        />
      </label>
      <button type="button" id="reset-evaluated-price" class="btn-ghost-sm" hidden={!results.isCustomEvaluatedPrice}>
        {t.common.resetToRecommended}
      </button>
    </div>

    {
      results.isUnaffordable && (
        <div class="callout callout-unaffordable" id="unaffordable-block">
          <p class="callout-title">{ta.whatWouldNeedToChange}</p>
          <ul id="unaffordable-reasons">
            {ta.unaffordableReasons(results.unaffordableReasons, results.unaffordableReasonDetails).map((reason) => (
              <li>{reason}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="lender-vs-sustainable">
      <div class="stat-block">
        <p class="stat-label">{ta.lenderApproves}</p>
        <p class="stat-value" id="lender-max" data-bind="lenderMax">{formatUSD(results.riskyMax)}</p>
      </div>
      <div class="stat-block">
        <p class="stat-label">{t.common.sustainUpTo}</p>
        <p class="stat-value" id="sustainable-max" data-bind="sustainableMax">{formatUSD(results.sustainableMax)}</p>
      </div>
    </div>
    <p class="gap-explanation" id="gap-explanation">
      {lenderSustainableGap > 500
        ? ta.gap(lenderSustainableGap)
        : ta.noGap}
    </p>

    <div class="breakdown">
      <p class="section-heading">{ta.monthlyCostAt(results.evaluatedPrice)}</p>
      <dl class="breakdown-list" id="breakdown-list">
        <div class="breakdown-row">
          <dt>{ta.principalInterest}</dt>
          <dd id="bd-pi" data-bind="pi">{formatUSD(breakdown.principalAndInterest)}</dd>
        </div>
        <div class="breakdown-row">
          <dt>{ta.propertyTax}</dt>
          <dd id="bd-tax" data-bind="tax">{formatUSD(breakdown.propertyTax)}</dd>
        </div>
        <div class="breakdown-row">
          <dt>{ta.homeInsurance}</dt>
          <dd id="bd-insurance" data-bind="insurance">{formatUSD(breakdown.insurance)}</dd>
        </div>
        <div class="breakdown-row" hidden={breakdown.pmi <= 0} id="bd-pmi-row">
          <dt>
            {ta.pmi}
            {breakdown.pmiDropoffMonth !== null && (
              <span class="dt-note" id="bd-pmi-note">
                {" "}
                {ta.pmiDrops(breakdown.pmiDropoffMonth)}
              </span>
            )}
          </dt>
          <dd id="bd-pmi" data-bind="pmi">{formatUSD(breakdown.pmi)}</dd>
        </div>
        <div class="breakdown-row" hidden={breakdown.hoa <= 0} id="bd-hoa-row">
          <dt>{ta.hoa}</dt>
          <dd id="bd-hoa" data-bind="hoa">{formatUSD(breakdown.hoa)}</dd>
        </div>
        <div class="breakdown-row breakdown-subtotal">
          <dt>{ta.lenderPayment}</dt>
          <dd id="bd-lender-total" data-bind="lenderTotal">{formatUSD(breakdown.lenderMonthlyPayment)}</dd>
        </div>
        <div class="breakdown-row">
          <dt>
            {ta.maintenance} <a class="info-link" href={`${methodologyHref}#maintenance`} aria-label={t.common.whyThisMatters}>?</a>
          </dt>
          <dd id="bd-maintenance" data-bind="maintenance">{formatUSD(breakdown.maintenance)}</dd>
        </div>
        <div class="breakdown-row breakdown-total">
          <dt>{ta.trueMonthlyCost}</dt>
          <dd id="bd-sustainable-total" data-bind="sustainableTotal">{formatUSD(breakdown.sustainableMonthlyPayment)}</dd>
        </div>
      </dl>
    </div>

    <div class={`callout leftover-callout ${affordability.householdCanSustain ? "callout-positive" : "callout-negative"}`} id="leftover-callout">
      <p class="stat-label">{ta.leftoverLabel}</p>
      <p class="stat-value" id="leftover-amount" data-bind="leftoverAmount">
        {formatSignedUSD(affordability.leftoverIncome)}
      </p>
      <p class="leftover-message" id="leftover-message">
        {affordability.householdCanSustain
          ? ta.canSustain
          : ta.cannotSustain}
      </p>
    </div>

    {
      results.constraints.length > 0 && (
        <div class="constraints" id="constraints-block">
          <p class="section-heading">{ta.whatsDriving}</p>
          <ul id="constraints-list">
            {results.constraints.map((c) => (
              <li data-constraint-id={c.id}>{ta.constraint(c)}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="sensitivity" id="sensitivity-panel">
      <p class="section-heading">{ta.whatWouldChange} <a class="info-link" href={`${methodologyHref}#sensitivity`} aria-label={t.common.whyThisMatters}>?</a></p>
      <div class="sensitivity-grid">
        <div class="sensitivity-card">
          <p class="sensitivity-label">{ta.sensRateLabel}</p>
          <p class="sensitivity-value" id="sens-rate" data-bind="sensRate">
            {formatUSD(sensitivity.rate.minusOnePoint)} · {formatUSD(sensitivity.rate.current)} · {formatUSD(sensitivity.rate.plusOnePoint)}
          </p>
          <p class="sensitivity-note">{ta.sensRateNote}</p>
        </div>
        <div class="sensitivity-card">
          <p class="sensitivity-label">{ta.sensIncomeLabel}</p>
          <p class="sensitivity-value" id="sens-income" data-bind="sensIncome">
            {tierLabels[sensitivity.incomeDrop.currentTier]} → {tierLabels[sensitivity.incomeDrop.droppedTier]}
          </p>
          <p class="sensitivity-note" id="sens-income-note">{ta.sensIncomeNote(sensitivity.incomeDrop.droppedGrossMonthlyIncome)}</p>
        </div>
        <div class="sensitivity-card">
          <p class="sensitivity-label">{ta.sensChildLabel}</p>
          <p class="sensitivity-value" id="sens-child" data-bind="sensChild">
            {tierLabels[sensitivity.addingChild.currentTier]} → {tierLabels[sensitivity.addingChild.withChildTier]}
          </p>
          <p class="sensitivity-note">{ta.sensChildNote(sensitivity.addingChild.addedMonthlyCost)}</p>
        </div>
        <div class="sensitivity-card">
          <p class="sensitivity-label">{ta.sensDownLabel((20_000).toLocaleString("en-US"))}</p>
          <p class="sensitivity-value" id="sens-downpayment" data-bind="sensDownPayment">
            {ta.perMonthChange(sensitivity.downPayment.currentTotalMonthly, sensitivity.downPayment.largerTotalMonthly)}
          </p>
          <p class="sensitivity-note" id="sens-downpayment-note">
            {ta.pmiChange(sensitivity.downPayment.currentPmiMonthly, sensitivity.downPayment.largerPmiMonthly)}
          </p>
        </div>
      </div>
    </div>

    <div class="share-row">
      <label class="field">
        <span>{t.common.shareLabel}</span>
        <input type="text" id="share-url" readonly value={shareUrl} onfocus="this.select()" />
      </label>
      <button type="button" id="copy-share-link" class="btn-primary-sm">{t.common.copyLink}</button>
      <span id="copy-confirmation" role="status" class="copy-confirmation" hidden>{t.common.copied}</span>
    </div>
  </div>
</div>

<script>
  import { initCalculator } from "../../scripts/calculatorClient";
  initCalculator();
</script>

<style>
  .calculator {
    display: grid;
    grid-template-columns: minmax(280px, 380px) 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (max-width: 900px) {
    .calculator {
      grid-template-columns: 1fr;
    }
  }

  .calculator-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: sticky;
    top: var(--space-lg);
  }

  @media (max-width: 900px) {
    .calculator-form {
      position: static;
    }
  }

  .field-group {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .field-group legend {
    font-size: var(--text-label-sm-size);
    font-weight: 600;
    padding: 0 var(--space-xs);
    color: var(--color-ink);
  }

  .field-group-note {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-top: calc(-1 * var(--space-xs));
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
    font-size: var(--text-body-sm-size);
    color: var(--color-body);
  }

  .field input,
  .field select {
    background: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-sm);
    min-height: 44px;
    width: 100%;
  }

  .field-inline {
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-body-sm-size);
  }

  .field-inline legend {
    font-weight: 500;
    padding: 0;
  }

  .field-inline label {
    display: flex;
    align-items: center;
    gap: var(--space-xxs);
    min-height: 44px;
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .results-header h2 {
    font-size: var(--text-heading-lg-size);
    font-weight: var(--text-heading-lg-weight);
    letter-spacing: var(--text-heading-lg-tracking);
    line-height: var(--text-heading-lg-leading);
  }

  .tier-badge {
    display: inline-block;
    padding: var(--space-xxs) var(--space-sm);
    border-radius: var(--radius-full);
    font-size: var(--text-label-sm-size);
    font-weight: 600;
    vertical-align: middle;
  }

  .tier-badge[data-tier="comfortable"] {
    background: var(--color-comfortable-soft);
    color: var(--color-comfortable);
  }
  .tier-badge[data-tier="stretch"] {
    background: var(--color-stretch-soft);
    color: var(--color-stretch);
  }
  .tier-badge[data-tier="risky"] {
    background: var(--color-risky-soft);
    color: var(--color-risky);
  }
  .tier-badge[data-tier="unaffordable"] {
    background: var(--color-unaffordable-soft);
    color: var(--color-unaffordable);
  }

  .evaluate-row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .evaluate-row .field {
    flex: 1;
    min-width: 200px;
  }

  .callout {
    border-radius: var(--radius-md);
    padding: var(--space-md);
    border: 1px solid var(--color-hairline);
  }

  .callout-title {
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .callout-unaffordable {
    background: var(--color-unaffordable-soft);
    border-color: transparent;
  }

  .callout-unaffordable ul {
    margin: 0;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .lender-vs-sustainable {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  @media (max-width: 480px) {
    .lender-vs-sustainable {
      grid-template-columns: 1fr;
    }
  }

  .stat-block {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .stat-label {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-bottom: var(--space-xxs);
  }

  .stat-value {
    font-size: var(--text-heading-md-size);
    font-weight: 600;
  }

  .gap-explanation {
    font-size: var(--text-body-sm-size);
    color: var(--color-body);
  }

  .section-heading {
    font-weight: 600;
    font-size: var(--text-label-sm-size);
    margin-bottom: var(--space-xs);
  }

  .breakdown-list {
    margin: 0;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-hairline-soft);
  }

  .breakdown-row dt {
    color: var(--color-body);
    font-size: var(--text-body-sm-size);
  }

  .dt-note {
    color: var(--color-mute);
  }

  .breakdown-row dd {
    margin: 0;
    font-weight: 500;
  }

  .breakdown-subtotal {
    background: var(--color-hairline-soft);
  }

  .breakdown-total {
    background: var(--color-ink);
  }

  .breakdown-total dt,
  .breakdown-total dd {
    color: var(--color-on-ink);
    font-weight: 600;
  }

  .leftover-callout.callout-positive {
    background: var(--color-comfortable-soft);
  }

  .leftover-callout.callout-negative {
    background: var(--color-unaffordable-soft);
  }

  .leftover-message {
    font-size: var(--text-body-sm-size);
    margin-top: var(--space-xxs);
  }

  .constraints ul {
    margin: 0;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: var(--text-body-md-size);
    color: var(--color-body);
  }

  .sensitivity-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  @media (max-width: 480px) {
    .sensitivity-grid {
      grid-template-columns: 1fr;
    }
  }

  .sensitivity-card {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
  }

  .sensitivity-label {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-bottom: var(--space-xxs);
  }

  .sensitivity-value {
    font-weight: 600;
  }

  .sensitivity-note {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-top: var(--space-xxs);
  }

  .share-row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-sm);
    flex-wrap: wrap;
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-lg);
  }

  .share-row .field {
    flex: 1;
    min-width: 200px;
  }

  .copy-confirmation {
    color: var(--color-comfortable);
    font-size: var(--text-body-sm-size);
    align-self: center;
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-on-ink);
    border: none;
    border-radius: var(--radius-pill);
    padding: var(--space-sm) var(--space-lg);
    font-size: var(--text-button-lg-size);
    font-weight: var(--text-button-lg-weight);
    min-height: 44px;
    cursor: pointer;
  }

  .btn-primary-sm,
  .btn-ghost-sm {
    border-radius: var(--radius-sm);
    padding: 0 var(--space-sm);
    min-height: 44px;
    font-size: var(--text-button-md-size);
    font-weight: var(--text-button-md-weight);
    cursor: pointer;
  }

