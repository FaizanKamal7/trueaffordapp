---
import { decodeScenario, scenarioToQueryString } from "../../lib/state/serialize";
import { computeCarResults } from "../../lib/state/computeCarResults";
import { getDefaultAutoLoanRate, BASE_RATE_AS_OF as AUTO_RATE_AS_OF } from "../../lib/data/auto-loan-rates-by-credit-band";
import { AUTO_SALES_TAX_BY_STATE } from "../../lib/data/auto-sales-tax-by-state";
import { CREDIT_BANDS } from "../../lib/data/pmi-rates";
import { formatUSD, formatSignedUSD } from "../../lib/format";
import ScaleBar from "./ScaleBar.astro";

import { DEFAULT_LOCALE, localizedPath, type LocaleCode } from "../../i18n/locales";
import { CALCULATOR_COPY } from "../../i18n/calculators";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = CALCULATOR_COPY[locale];

const scenario = decodeScenario(Astro.url.searchParams);
const results = computeCarResults(scenario);
const { affordability } = results;
const { breakdown } = affordability;

const stateList = Object.values(AUTO_SALES_TAX_BY_STATE).sort((a, b) => a.state.localeCompare(b.state));
const defaultRatePct = getDefaultAutoLoanRate(scenario.carCreditBand) * 100;
const termOptions = [36, 48, 60, 72] as const;

const shareUrl = new URL(Astro.url.pathname + scenarioToQueryString(scenario), Astro.site ?? Astro.url.origin).toString();

const tierLabels = t.tiers;
const tc = t.car;

const ruleVsSustainableGap = results.ruleVsSustainableGap;
const mobileHeadline = results.isUnaffordable ? t.common.notAffordableYet : `${tierLabels[affordability.tier]}${t.common.upTo}${formatUSD(results.evaluatedPrice)}`;
---

<div class="calculator-grid" data-car-calculator data-locale={locale}>
  <form id="car-form" class="calculator-form-col" method="get">
    <div class="mobile-result-summary" aria-hidden="true">
      <p class="eyebrow">{t.common.yourResult}</p>
      <p class="mobile-result-value" id="car-mobile-headline">{mobileHeadline}</p>
      <a href="#car-results" tabindex="-1">{t.common.seeFullBreakdown}</a>
    </div>
    <fieldset class="field-group">
      <legend>{t.common.incomeAndDebts}</legend>
      <label class="field">
        <span>{t.common.grossIncome}</span>
        <input type="number" inputmode="numeric" name="gi" id="field-gi" min="0" step="1000" value={scenario.grossAnnualIncome} />
      </label>
      <label class="field">
        <span>{t.common.netIncome}</span>
        <input type="number" inputmode="numeric" name="ni" id="field-ni" min="0" step="50" value={scenario.netMonthlyIncome} />
      </label>
      <label class="field">
        <span>{t.common.otherDebts}</span>
        <input type="number" inputmode="numeric" name="od" id="field-od" min="0" step="25" value={scenario.otherMonthlyDebts} />
      </label>
    </fieldset>

    <fieldset class="field-group">
      <legend>{t.common.realLifeExpenses}</legend>
      <p class="field-group-note">{tc.expensesNote}</p>
      <label class="field">
        <span>{t.common.childcare}</span>
        <input type="number" inputmode="numeric" name="ec" id="field-ec" min="0" step="25" value={scenario.childcare} />
      </label>
      <label class="field">
        <span>{t.common.healthcare}</span>
        <input type="number" inputmode="numeric" name="eh" id="field-eh" min="0" step="25" value={scenario.healthcare} />
      </label>
      <label class="field">
        <span>{t.common.groceries}</span>
        <input type="number" inputmode="numeric" name="eg" id="field-eg" min="0" step="25" value={scenario.groceries} />
      </label>
      <label class="field">
        <span>{t.common.transport}</span>
        <input type="number" inputmode="numeric" name="et" id="field-et" min="0" step="25" value={scenario.transport} />
      </label>
      <label class="field">
        <span>{t.common.other}</span>
        <input type="number" inputmode="numeric" name="eo" id="field-eo" min="0" step="25" value={scenario.otherExpenses} />
      </label>
    </fieldset>

    <fieldset class="field-group">
      <legend>{tc.carLoanAssumptions}</legend>

      <label class="field">
        <span>{tc.stateForTax}</span>
        <select name="st" id="field-st">
          {
            stateList.map((entry) => (
              <option value={entry.stateCode} selected={entry.stateCode === scenario.stateCode}>
                {entry.state}
              </option>
            ))
          }
        </select>
      </label>

      <label class="field">
        <span>{t.common.downPayment}</span>
        <input type="number" inputmode="numeric" name="cdp" id="field-cdp" min="0" step="500" value={scenario.carDownPaymentDollars} />
      </label>

      <label class="field">
        <span>{tc.tradeIn}</span>
        <input type="number" inputmode="numeric" name="cti" id="field-cti" min="0" step="500" value={scenario.carTradeInValueDollars} />
      </label>

      <label class="field">
        <span>{t.common.creditBand}</span>
        <select name="ccb" id="field-ccb">
          {
            CREDIT_BANDS.map((band) => (
              <option value={band} selected={band === scenario.carCreditBand}>
                {band}
              </option>
            ))
          }
        </select>
      </label>

      <label class="field">
        <span>{t.common.rateOverride} <a class="info-link" href={localizedPath(locale, "methodology")} aria-label={t.common.whyThisMatters}>?</a></span>
        <input
          type="number"
          inputmode="decimal"
          name="cir"
          id="field-cir"
          min="0"
          max="30"
          step="0.05"
          placeholder={defaultRatePct.toFixed(2)}
          value={scenario.carInterestRateOverride !== undefined ? (scenario.carInterestRateOverride * 100).toFixed(2) : ""}
        />
      </label>

      <fieldset class="field-inline">
        <legend>{t.common.loanTerm}</legend>
        {
          termOptions.map((months) => (
            <label>
              <input type="radio" name="ctm" value={months} checked={scenario.carTermMonths === months} /> {tc.termMonths(months)}
            </label>
          ))
        }
      </fieldset>

      <label class="field">
        <span>{tc.autoInsurance}</span>
        <input type="number" inputmode="numeric" name="cin" id="field-cin" min="0" step="10" value={scenario.carInsuranceMonthly} />
      </label>
    </fieldset>

    <p class="rate-disclosure">{tc.rateDisclosure(AUTO_RATE_AS_OF)}</p>

    <noscript>
      <button type="submit" class="btn-primary">{t.common.calculate}</button>
    </noscript>
  </form>

  <div class="results-col" id="car-results" aria-live="polite">
    <div>
      <p class="eyebrow">{t.common.yourResult}</p>
      {
        results.isUnaffordable ? (
          <h2 id="car-headline" data-bind="headline">
            {t.common.notAffordableYet}
          </h2>
        ) : (
          <h2 id="car-headline" data-bind="headline">
            <span class="tier-badge" data-tier={affordability.tier} id="car-tier-badge">
              {tierLabels[affordability.tier]}
            </span>{" "}
            {t.common.upTo.trimStart()}<strong id="car-evaluated-price" data-bind="evaluatedPrice">{formatUSD(results.evaluatedPrice)}</strong>
          </h2>
        )
      }
    </div>

    <ScaleBar locale={locale} comfortableMax={results.comfortableMax} stretchMax={results.stretchMax} riskyMax={results.riskyMax} evaluatedPrice={results.evaluatedPrice} />

    <div class="evaluate-row">
      <label class="field">
        <span>{tc.testPrice}</span>
        <input
          type="number"
          inputmode="numeric"
          name="cep"
          id="field-cep"
          form="car-form"
          min="0"
          step="500"
          value={results.isCustomEvaluatedPrice ? results.evaluatedPrice : ""}
          placeholder={String(results.defaultEvaluatedPrice)}
        />
      </label>
      <button type="button" id="reset-evaluated-car-price" class="btn-ghost-sm" hidden={!results.isCustomEvaluatedPrice}>
        {t.common.resetToRecommended}
      </button>
    </div>

    <div class="two-col-stats">
      <div class="stat-block">
        <p class="stat-label">{tc.ruleAllows}</p>
        <p class="stat-value" id="car-rule-max" data-bind="ruleMax">{formatUSD(results.riskyMax)}</p>
      </div>
      <div class="stat-block">
        <p class="stat-label">{t.common.sustainUpTo}</p>
        <p class="stat-value" id="car-sustainable-max" data-bind="sustainableMax">{formatUSD(results.sustainableMax)}</p>
      </div>
    </div>
    <p class="gap-explanation" id="car-gap-explanation">
      {ruleVsSustainableGap > 500
        ? tc.gap(ruleVsSustainableGap)
        : tc.noGap}
    </p>

    <div class="breakdown">
      <p class="section-heading">{tc.costBreakdownAt(results.evaluatedPrice)}</p>
      <dl class="breakdown-list" id="car-breakdown-list">
        <div class="breakdown-row">
          <dt>{tc.salesTax}</dt>
          <dd id="bd-car-tax" data-bind="carTax">{formatUSD(breakdown.salesTax)}</dd>
        </div>
        <div class="breakdown-row">
          <dt>{tc.amountFinanced}</dt>
          <dd id="bd-car-financed" data-bind="carFinanced">{formatUSD(breakdown.amountFinanced)}</dd>
        </div>
        <div class="breakdown-row">
          <dt>{tc.monthlyPrincipalInterest}</dt>
          <dd id="bd-car-pi" data-bind="carPi">{formatUSD(breakdown.principalAndInterest)}</dd>
        </div>
        <div class="breakdown-row">
          <dt>{tc.monthlyInsurance}</dt>
          <dd id="bd-car-insurance" data-bind="carInsurance">{formatUSD(breakdown.insurance)}</dd>
        </div>
        <div class="breakdown-row breakdown-total">
          <dt>{tc.totalMonthlyCost}</dt>
          <dd id="bd-car-total" data-bind="carTotal">{formatUSD(breakdown.totalMonthlyCost)}</dd>
        </div>
      </dl>
      <p class="rule-explainer">{tc.excludes}</p>
    </div>

    <div class={`callout leftover-callout ${affordability.householdCanSustain ? "callout-positive" : "callout-negative"}`} id="car-leftover-callout">
      <p class="stat-label">{tc.leftoverLabel}</p>
      <p class="stat-value" id="car-leftover-amount" data-bind="carLeftoverAmount">{formatSignedUSD(affordability.leftoverIncome)}</p>
      <p class="leftover-message" id="car-leftover-message">
        {affordability.householdCanSustain
          ? tc.canSustain
          : tc.cannotSustain}
      </p>
    </div>

    <div class="share-row">
      <label class="field">
        <span>{t.common.shareLabel}</span>
        <input type="text" id="share-url" readonly value={shareUrl} onfocus="this.select()" />
      </label>
      <button type="button" id="copy-share-link" class="btn-primary-sm">{t.common.copyLink}</button>
      <span id="copy-confirmation" role="status" class="copy-confirmation" hidden>{t.common.copied}</span>
    </div>
  </div>
</div>

<script>
  import { initCarCalculator } from "../../scripts/carCalculatorClient";
  initCarCalculator();
</script>

<style>
  .rate-disclosure {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
  }

  .rule-explainer {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
    margin-top: var(--space-xs);
  }

  .leftover-callout.callout-positive {
    background: var(--color-comfortable-soft);
  }

  .leftover-callout.callout-negative {
    background: var(--color-unaffordable-soft);
  }

  .leftover-message {
    font-size: var(--text-body-sm-size);
    margin-top: var(--space-xxs);
  }

  .gap-explanation {
    font-size: var(--text-body-sm-size);
    color: var(--color-body);
  }
</style>
