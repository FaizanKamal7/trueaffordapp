---
import { decodeScenario, scenarioToQueryString } from "../../lib/state/serialize";
import { computeRentVsBuyResults } from "../../lib/state/computeRentVsBuyResults";
import { computeRentVsBuyChartGeometry } from "../../lib/rentVsBuyChartGeometry";
import { PROPERTY_TAX_BY_STATE } from "../../lib/data/property-tax-by-state";
import { CREDIT_BANDS } from "../../lib/data/pmi-rates";
import { formatUSD, formatSignedUSD } from "../../lib/format";

const scenario = decodeScenario(Astro.url.searchParams);
const results = computeRentVsBuyResults(scenario);
const { simulation } = results;

const stateList = Object.values(PROPERTY_TAX_BY_STATE).sort((a, b) => a.state.localeCompare(b.state));
const geometry = computeRentVsBuyChartGeometry(simulation.timeline, results.tenureYears, simulation.breakevenYear);

const shareUrl = new URL(Astro.url.pathname + scenarioToQueryString(scenario), Astro.site ?? Astro.url.origin).toString();

const choiceLabels: Record<string, string> = { buy: "Buying", rent: "Renting", "roughly equal": "Roughly a tie" };
const diff = Math.abs(simulation.netWorthAtTenure.buyer - simulation.netWorthAtTenure.renter);
---

<div class="calculator-grid" data-rentvsbuy-calculator>
  <form id="rvb-form" class="calculator-form-col" method="get">
    <fieldset class="field-group">
      <legend>Buying scenario</legend>
      <label class="field">
        <span>Home price</span>
        <input type="number" inputmode="numeric" name="ep" id="field-ep" min="0" step="1000" value={results.homePrice} />
      </label>
      <label class="field">
        <span>State</span>
        <select name="st" id="field-st">
          {
            stateList.map((entry) => (
              <option value={entry.stateCode} selected={entry.stateCode === scenario.stateCode}>
                {entry.state}
              </option>
            ))
          }
        </select>
      </label>
      <label class="field">
        <span>Down payment</span>
        <input type="number" inputmode="numeric" name="dp" id="field-dp" min="0" step="1000" value={scenario.downPaymentDollars} />
      </label>
      <label class="field">
        <span>Credit score band</span>
        <select name="cb" id="field-cb">
          {
            CREDIT_BANDS.map((band) => (
              <option value={band} selected={band === scenario.creditBand}>
                {band}
              </option>
            ))
          }
        </select>
      </label>
      <fieldset class="field-inline">
        <legend>Loan term</legend>
        <label><input type="radio" name="tm" value="30" checked={scenario.termYears === 30} /> 30-year</label>
        <label><input type="radio" name="tm" value="15" checked={scenario.termYears === 15} /> 15-year</label>
      </fieldset>
    </fieldset>

    <fieldset class="field-group">
      <legend>Renting scenario</legend>
      <label class="field">
        <span>Monthly rent</span>
        <input type="number" inputmode="numeric" name="er" id="field-er" min="0" step="50" value={results.monthlyRent} />
      </label>
      <label class="field">
        <span>Renters insurance (monthly)</span>
        <input type="number" inputmode="numeric" name="ri" id="field-ri" min="0" step="5" value={scenario.rentersInsuranceMonthly} />
      </label>
      <label class="field">
        <span>Utilities (monthly)</span>
        <input type="number" inputmode="numeric" name="ut" id="field-ut" min="0" step="10" value={scenario.utilitiesMonthly} />
      </label>
    </fieldset>

    <fieldset class="field-group">
      <legend>Timeline</legend>
      <label class="field">
        <span>Expected years in the home</span>
        <input type="number" inputmode="numeric" name="ty" id="field-ty" min="1" max="30" step="1" value={scenario.tenureYears} />
      </label>
    </fieldset>

    <noscript>
      <button type="submit" class="btn-primary">Calculate</button>
    </noscript>
  </form>

  <div class="results-col" id="rvb-results" aria-live="polite">
    <div>
      <p class="eyebrow">At {results.tenureYears} years</p>
      <h2 id="rvb-headline">
        <strong id="rvb-choice" data-bind="choice">{choiceLabels[simulation.betterChoiceAtTenure]}</strong> comes out ahead by
        <strong id="rvb-diff" data-bind="diff">{formatUSD(diff)}</strong>
      </h2>
      <p class="breakeven-note" id="rvb-breakeven">
        {simulation.breakevenYear !== null ? `Buying overtakes renting in net worth around year ${simulation.breakevenYear}.` : "Buying doesn't overtake renting in net worth within 30 years at these assumptions."}
      </p>
    </div>

    <svg class="rvb-chart" viewBox={`0 0 ${geometry.width} ${geometry.height}`} role="img" aria-label="Net worth over time: buying versus renting">
      <line x1="0" y1={geometry.zeroY} x2={geometry.width} y2={geometry.zeroY} stroke="var(--color-hairline)" stroke-width="1" />
      {geometry.breakevenX !== null && <line id="breakeven-line" x1={geometry.breakevenX} y1="0" x2={geometry.breakevenX} y2={geometry.height} stroke="var(--color-mute)" stroke-width="1" stroke-dasharray="4 3" />}
      <line id="tenure-line" x1={geometry.tenureX} y1="0" x2={geometry.tenureX} y2={geometry.height} stroke="var(--color-ink)" stroke-width="1" stroke-dasharray="2 2" />
      <polyline id="renter-line" points={geometry.renterPoints} fill="none" stroke="var(--color-link)" stroke-width="2" />
      <polyline id="buyer-line" points={geometry.buyerPoints} fill="none" stroke="var(--color-comfortable)" stroke-width="2" />
    </svg>
    <div class="chart-legend">
      <span class="legend-item"><span class="swatch swatch-buy"></span>Buying net worth</span>
      <span class="legend-item"><span class="swatch swatch-rent"></span>Renting net worth</span>
    </div>

    <div class="two-col-stats">
      <div class="stat-block">
        <p class="stat-label">Buying net worth at year {results.tenureYears}</p>
        <p class="stat-value" id="buyer-net-worth" data-bind="buyerNetWorth">{formatSignedUSD(simulation.netWorthAtTenure.buyer)}</p>
      </div>
      <div class="stat-block">
        <p class="stat-label">Renting net worth at year {results.tenureYears}</p>
        <p class="stat-value" id="renter-net-worth" data-bind="renterNetWorth">{formatSignedUSD(simulation.netWorthAtTenure.renter)}</p>
      </div>
    </div>

    <p class="rvb-assumptions">
      Assumes {(3).toFixed(0)}% annual home appreciation, {(6).toFixed(0)}% investment return on the money not spent buying, {(3).toFixed(0)}% annual rent growth, and 6% selling costs. See the <a
        href="/methodology#rent-vs-buy">methodology</a
      > for the full model.
    </p>

    <div class="share-row">
      <label class="field">
        <span>Share this exact scenario</span>
        <input type="text" id="share-url" readonly value={shareUrl} onfocus="this.select()" />
      </label>
      <button type="button" id="copy-share-link" class="btn-primary-sm">Copy link</button>
      <span id="copy-confirmation" role="status" class="copy-confirmation" hidden>Copied!</span>
    </div>
  </div>
</div>

<script>
  import { initRentVsBuyCalculator } from "../../scripts/rentVsBuyCalculatorClient";
  initRentVsBuyCalculator();
</script>

<style>
  .rvb-chart {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas-elevated);
  }

  .chart-legend {
    display: flex;
    gap: var(--space-lg);
    font-size: var(--text-body-sm-size);
    color: var(--color-body);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-xxs);
  }

  .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
  }

  .swatch-buy {
    background: var(--color-comfortable);
  }

  .swatch-rent {
    background: var(--color-link);
  }

  .breakeven-note {
    color: var(--color-body);
    font-size: var(--text-body-sm-size);
    margin-top: var(--space-xxs);
  }

  .rvb-assumptions {
    font-size: var(--text-body-sm-size);
    color: var(--color-mute);
  }
</style>
