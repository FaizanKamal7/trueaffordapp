---
import { DEFAULT_LOCALE, LOCALES, localizedPath, type LocaleCode } from "../../i18n/locales";
import { CHROME } from "../../i18n/chrome";

interface Props {
  locale?: LocaleCode;
  /** Path slug (without locale prefix) shared by every translated version of this page. */
  translationSlug?: string;
}

const { locale = DEFAULT_LOCALE, translationSlug } = Astro.props;
const t = CHROME[locale];
const currentLocaleConfig = LOCALES.find((l) => l.code === locale) ?? LOCALES[0];
const languageLinks = LOCALES.map((l) => ({
  code: l.code,
  label: l.label,
  href: localizedPath(l.code, translationSlug ?? ""),
}));

const navLinks = [
  { href: localizedPath(locale, "home-affordability-calculator"), label: t.nav.homeAffordability },
  { href: localizedPath(locale, "mortgage-calculator"), label: t.nav.mortgageCalculator },
  { href: localizedPath(locale, "methodology"), label: t.nav.methodology },
];

const homeHref = localizedPath(locale, "");
const currentPath = Astro.url.pathname;
---

<header class="nav-shell">
  <div class="nav-bar">
    <div class="container nav-inner">
      <a href={homeHref} class="wordmark">
        <img src="/logo.png" alt="" width="44" height="44" class="logo-mark" />
        TrueAfford
      </a>
      <nav aria-label="Primary">
        <ul class="nav-list">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="nav-link" aria-current={currentPath === link.href ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="nav-actions">
        <details class="lang-switch">
          <summary class="lang-switch-trigger" aria-label={t.nav.changeLanguage} title={t.nav.changeLanguage}>
            <svg class="lang-switch-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18" />
              <path d="M12 3c2.5 2.7 4 6 4 9s-1.5 6.3-4 9c-2.5-2.7-4-6-4-9s1.5-6.3 4-9z" />
            </svg>
            <span class="visually-hidden">{t.nav.changeLanguage}</span>
          </summary>
          <ul class="lang-switch-menu">
            {
              languageLinks.map((l) => (
                <li>
                  <a href={l.href} aria-current={l.code === currentLocaleConfig.code ? "true" : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <button
          class="theme-toggle"
          type="button"
          aria-label={t.nav.switchToDarkMode}
          title={t.nav.switchToDarkMode}
          data-switch-to-dark={t.nav.switchToDarkMode}
          data-switch-to-light={t.nav.switchToLightMode}
        >
          <span class="theme-toggle-icon" aria-hidden="true">☾</span>
          <span class="visually-hidden">{t.nav.switchColorTheme}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const navShell = document.querySelector<HTMLElement>(".nav-shell");

  const updateNavState = () => {
    navShell?.classList.toggle("is-stuck", window.scrollY > 12);
  };

  updateNavState();
  window.addEventListener("scroll", updateNavState, { passive: true });

  const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const setThemeToggleLabel = (theme: "light" | "dark") => {
    if (themeToggle) {
      const label = theme === "dark" ? themeToggle.dataset.switchToLight : themeToggle.dataset.switchToDark;
      if (label) {
        themeToggle.setAttribute("aria-label", label);
        themeToggle.title = label;
      }
      const icon = themeToggle.querySelector(".theme-toggle-icon");
      if (icon) icon.textContent = theme === "dark" ? "☀" : "☾";
    }
  };

  setThemeToggleLabel(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
  themeToggle?.addEventListener("click", () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("trueafford-theme", theme);
    setThemeToggleLabel(theme);
  });

  const langSwitch = document.querySelector<HTMLDetailsElement>(".lang-switch");
  document.addEventListener("click", (event) => {
    if (langSwitch?.open && !langSwitch.contains(event.target as Node)) {
      langSwitch.open = false;
    }
  });
</script>

<style>
  .nav-shell {
    background:
      radial-gradient(circle at 78% 42%, var(--color-nav-glow) 0, transparent 34%),
      linear-gradient(120deg, var(--color-nav-start) 0%, var(--color-nav-middle) 52%, var(--color-nav-end) 100%);
    padding-block: var(--space-sm);
    position: sticky;
    top: 0;
    z-index: 20;
    transition: padding 0.2s ease;
  }

  .nav-bar {
    width: min(calc(100% - (var(--space-lg) * 2)), var(--container-max));
    margin-inline: auto;
    background: var(--color-nav-panel);
    border: 1px solid var(--color-nav-border);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-nav);
    transition:
      width 0.2s ease,
      margin 0.2s ease,
      border-radius 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-shell.is-stuck {
    padding-block: 0;
  }

  .nav-shell.is-stuck .nav-bar {
    width: 100%;
    margin-block: 0;
    border-inline: 0;
    border-radius: 0;
    box-shadow: var(--shadow-nav);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 600;
    font-size: var(--text-heading-md-size);
    letter-spacing: var(--text-heading-md-tracking);
    color: var(--color-ink);
    text-decoration: none;
  }

  .logo-mark {
    width: 44px;
    height: 44px;
    filter: brightness(0);
  }

  :global(html[data-theme="dark"]) .logo-mark {
    filter: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-block;
    color: var(--color-body);
    font-size: var(--text-body-md-size);
    text-decoration: none;
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-sm);
  }

  .nav-link:hover {
    background: var(--color-hairline-soft);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    background: var(--color-hairline-soft);
    font-weight: 500;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--color-canvas-elevated);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-size: 18px;
  }

  .theme-toggle:hover {
    background: var(--color-hairline-soft);
  }

  .lang-switch {
    position: relative;
  }

  .lang-switch-trigger {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--color-canvas-elevated);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-size: 18px;
    list-style: none;
  }

  .lang-switch-trigger::-webkit-details-marker {
    display: none;
  }

  .lang-switch-trigger:hover {
    background: var(--color-hairline-soft);
  }

  .lang-switch[open] .lang-switch-trigger {
    background: var(--color-hairline-soft);
  }

  .lang-switch-menu {
    position: absolute;
    top: calc(100% + var(--space-xs));
    right: 0;
    z-index: 30;
    display: grid;
    gap: 2px;
    min-width: 180px;
    max-height: 320px;
    overflow-y: auto;
    margin: 0;
    padding: var(--space-xs);
    list-style: none;
    background: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-nav);
  }

  .lang-switch-menu a {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--color-body);
    text-decoration: none;
    font-size: var(--text-body-md-size);
    white-space: nowrap;
  }

  .lang-switch-menu a:hover {
    background: var(--color-hairline-soft);
  }

  .lang-switch-menu a[aria-current="true"] {
    color: var(--color-ink);
    font-weight: 500;
    background: var(--color-hairline-soft);
  }
</style>
